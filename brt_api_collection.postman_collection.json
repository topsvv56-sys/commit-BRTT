		{
			"name": "2. Firebase Auth (brtapp-6d721)",
			"item": [
				{
					"name": "Sign In with Phone as Email (Firebase Login)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"55800549@brtapp.com\",\n    \"password\": \"12345678\",\n    \"returnSecureToken\": true\n}"
						},
						"url": {
							"raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{FIREBASE_API_KEY}}",
							"protocol": "https",
							"host": [
								"identitytoolkit",
								"googleapis",
								"com"
							],
							"path": [
								"v1",
								"accounts:signInWithPassword"
							],
							"query": [
								{
									"key": "key",
									"value": "{{FIREBASE_API_KEY}}"
								}
							]
						},
						"description": "API เข้าสู่ระบบของ Firebase ตามที่เขียนไว้ใน LoginPage (แปลงเบอร์เป็น @brtapp.com)"
					},
					"response": []
				},
